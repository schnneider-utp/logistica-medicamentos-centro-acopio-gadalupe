---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import prisma from '../lib/prisma';
import { formatDate } from '../lib/utils';

const search = Astro.url.searchParams.get('search') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 12;
const skip = (page - 1) * pageSize;

const whereClause = search ? {
  OR: [
    { nombre: { contains: search, mode: 'insensitive' } },
    { direccion: { contains: search, mode: 'insensitive' } },
  ],
} : undefined;

const [beneficiariosRaw, totalCount] = await Promise.all([
  prisma.beneficiarios.findMany({
    where: whereClause,
    include: { _count: { select: { entregas: true } } },
    orderBy: { nombre: 'asc' },
    skip,
    take: pageSize,
  }),
  prisma.beneficiarios.count({ where: whereClause }),
]);

const beneficiarioIds = beneficiariosRaw.map(b => b.id);

const ultimasEntregasRaw = beneficiarioIds.length > 0
  ? await prisma.$queryRaw<{ beneficiario_id: number; fecha_entrega: Date; nombre_generico: string | null; concentracion: string | null }[]>`
    SELECT e.beneficiario_id, e.fecha_entrega, mi.nombre_generico, mi.concentracion
    FROM entregas e
    INNER JOIN detalle_entrega de ON de.entrega_id = e.id
    INNER JOIN medicamentos_inventario mi ON mi.id = de.medicamento_id
    WHERE e.id IN (
      SELECT e2.id FROM entregas e2
      WHERE e2.beneficiario_id = ANY(${beneficiarioIds})
      ORDER BY e2.fecha_entrega DESC
      LIMIT 1 OFFSET 0
    )
  `
  : [];

const ultimaEntregaMap = new Map<number, { fecha: Date; medicamento: string }>();
for (const row of ultimasEntregasRaw) {
  if (!ultimaEntregaMap.has(row.beneficiario_id)) {
    const med = [row.nombre_generico, row.concentracion].filter(Boolean).join(' ');
    ultimaEntregaMap.set(row.beneficiario_id, { fecha: row.fecha_entrega, medicamento: med });
  }
}

const beneficiarios = beneficiariosRaw.map(b => ({
  id: b.id,
  nombre: b.nombre,
  celular: b.celular,
  direccion: b.direccion,
  entregas: b._count.entregas,
  ultimoMedicamento: ultimaEntregaMap.get(b.id)?.medicamento || '',
  fechaUltima: ultimaEntregaMap.get(b.id)?.fecha || null,
}));

const totalPages = Math.ceil(totalCount / pageSize);

const [totalBeneficiarios, totalEntregas] = await Promise.all([
  prisma.beneficiarios.count(),
  prisma.entregas.count(),
]);

const hace30Dias = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
const beneficiariosActivos = await prisma.beneficiarios.count({
  where: { entregas: { some: { fecha_entrega: { gte: hace30Dias } } } },
});
---

<Layout title="Beneficiarios | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <div class="header-top">
          <div>
            <h1>👥 Beneficiarios</h1>
            <p>Directorio de personas que reciben medicamentos del centro de acopio</p>
          </div>
        </div>
      </div>

      <form method="GET" class="search-section animate-fade-in-up delay-1">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input type="text" name="search" value={search} placeholder="Buscar por nombre o dirección..." class="form-input search-input" />
        </div>
      </form>

      <div class="quick-stats animate-fade-in-up delay-2">
        <div class="quick-stat">
          <span class="quick-stat-value">{totalBeneficiarios}</span>
          <span class="quick-stat-label">Total Beneficiarios</span>
        </div>
        <div class="quick-stat">
          <span class="quick-stat-value">{beneficiariosActivos}</span>
          <span class="quick-stat-label">Activos (últimos 30 días)</span>
        </div>
        <div class="quick-stat">
          <span class="quick-stat-value">{totalEntregas}</span>
          <span class="quick-stat-label">Entregas Totales</span>
        </div>
      </div>

      <div class="beneficiarios-grid">
        {beneficiarios.map((b, i) => (
          <div class="beneficiary-card animate-on-scroll" style={`transition-delay: ${i * 0.08}s`}>
            <div class="card-header">
              <div class="avatar">{b.nombre.charAt(0)}</div>
              <div class="card-title">
                <h3>{b.nombre}</h3>
                <span class="card-id">ID: #{b.id.toString().padStart(4, '0')}</span>
              </div>
            </div>

            <div class="card-body">
              {b.celular && (
                <div class="info-row">
                  <span class="info-icon">📱</span>
                  <span>{b.celular}</span>
                </div>
              )}
              {b.direccion && (
                <div class="info-row">
                  <span class="info-icon">📍</span>
                  <span>{b.direccion}</span>
                </div>
              )}
            </div>

            <div class="card-footer">
              <div class="footer-stat">
                <span class="footer-stat-value">{b.entregas}</span>
                <span class="footer-stat-label">entregas</span>
              </div>
              <div class="footer-info">
                {b.ultimoMedicamento && <span class="footer-med">{b.ultimoMedicamento}</span>}
                {b.fechaUltima && <span class="footer-date">{formatDate(b.fechaUltima)}</span>}
              </div>
            </div>
          </div>
        ))}
        {beneficiarios.length === 0 && (
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px; color: var(--text-muted);">
            No se encontraron beneficiarios
          </div>
        )}
      </div>

      {totalPages > 1 && (
        <div class="pagination">
          <span class="pagination-info">Página {page} de {totalPages} ({totalCount} total)</span>
          <div class="pagination-btns">
            {page > 1 && <a href={`?page=${page - 1}${search ? `&search=${search}` : ''}`} class="btn btn-ghost btn-sm">← Anterior</a>}
            {page < totalPages && <a href={`?page=${page + 1}${search ? `&search=${search}` : ''}`} class="btn btn-ghost btn-sm">Siguiente →</a>}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding-top: 72px; min-height: 100vh; padding-bottom: 40px; }
  .page-header { padding: 40px 0 24px; }
  .header-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .page-header h1 { font-size: 1.8rem; color: var(--green-dark); margin-bottom: 4px; }
  .page-header p { color: var(--text-muted); font-size: 1rem; }
  .search-section { margin-bottom: 24px; }
  .search-box { position: relative; max-width: 400px; }
  .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem; }
  .search-input { padding-left: 42px !important; width: 100%; }
  .quick-stats { display: flex; gap: 16px; margin-bottom: 32px; }
  .quick-stat { padding: 16px 24px; background: var(--surface); border-radius: var(--radius-md); border: 1px solid var(--border-light); display: flex; flex-direction: column; }
  .quick-stat-value { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--green-primary); }
  .quick-stat-label { font-size: 0.8rem; color: var(--text-muted); }
  .beneficiarios-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .beneficiary-card { background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
  .beneficiary-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); border-color: var(--green-light); }
  .card-header { display: flex; align-items: center; gap: 12px; padding: 20px 20px 0; }
  .avatar { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--green-primary), var(--green-light)); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; flex-shrink: 0; }
  .card-title { flex: 1; min-width: 0; }
  .card-title h3 { font-size: 1rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-id { font-size: 0.75rem; color: var(--text-light); }
  .card-body { padding: 16px 20px; display: flex; flex-direction: column; gap: 8px; }
  .info-row { display: flex; align-items: flex-start; gap: 8px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; }
  .info-icon { flex-shrink: 0; font-size: 0.9rem; }
  .card-footer { display: flex; justify-content: space-between; align-items: flex-end; padding: 14px 20px; background: var(--surface-hover); border-top: 1px solid var(--border-light); }
  .footer-stat { display: flex; align-items: baseline; gap: 4px; }
  .footer-stat-value { font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; color: var(--green-primary); }
  .footer-stat-label { font-size: 0.75rem; color: var(--text-muted); }
  .footer-info { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
  .footer-med { font-size: 0.8rem; font-weight: 500; color: var(--blue); }
  .footer-date { font-size: 0.7rem; color: var(--text-light); }
  .pagination { display: flex; justify-content: space-between; align-items: center; padding: 24px 0; margin-top: 16px; }
  .pagination-info { font-size: 0.85rem; color: var(--text-muted); }
  .pagination-btns { display: flex; gap: 8px; }
  @media (max-width: 1024px) { .beneficiarios-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .header-top { flex-direction: column; } .quick-stats { flex-direction: column; } .beneficiarios-grid { grid-template-columns: 1fr; } }
</style>
