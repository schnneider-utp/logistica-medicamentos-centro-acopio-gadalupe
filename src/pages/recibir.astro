---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Recibir Donación | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <h1>📥 Recibir Donación</h1>
        <p>Registra un nuevo lote de medicamentos o insumos médicos donados</p>
      </div>

      <!-- PASOS -->
      <div class="steps-bar animate-fade-in-up delay-1">
        <div class="step active" data-step="1">
          <span class="step-number">1</span>
          <span class="step-label">Datos del Donante</span>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="2">
          <span class="step-number">2</span>
          <span class="step-label">Medicamento</span>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="3">
          <span class="step-number">3</span>
          <span class="step-label">Comprobante</span>
        </div>
      </div>

      <div class="form-container animate-fade-in-up delay-2">
        <!-- PASO 1: DONANTE -->
        <div class="form-step active" id="step1">
          <div class="form-card">
            <div class="form-card-header">
              <span class="form-card-icon">🤝</span>
              <div>
                <h2>Información del Donante</h2>
                <p>Datos de la persona o fundación que realiza la donación</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">Nombre completo o fundación *</label>
                <input type="text" class="form-input" placeholder="Ej: Fundación Salud o Juan Pérez" />
              </div>
              <div class="form-group">
                <label class="form-label">Número de celular</label>
                <input type="tel" class="form-input" placeholder="Ej: 300 123 4567" />
              </div>
              <div class="form-group full-width">
                <label class="form-label">Correo electrónico</label>
                <input type="email" class="form-input" placeholder="Ej: contacto@fundacion.org" />
              </div>
            </div>

            <div class="form-note">
              <span>💡</span>
              <span>Esta información es opcional pero ayuda a mantener un registro de las donaciones recibidas.</span>
            </div>

            <div class="form-actions">
              <div></div>
              <button class="btn btn-primary" onclick="nextStep(2)">
                Siguiente: Medicamento →
              </button>
            </div>
          </div>
        </div>

        <!-- PASO 2: MEDICAMENTO -->
        <div class="form-step" id="step2">
          <div class="form-card">
            <div class="form-card-header">
              <span class="form-card-icon">💊</span>
              <div>
                <h2>Datos del Medicamento</h2>
                <p>Información detallada del medicamento o insumo médico</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">Nombre genérico *</label>
                <input type="text" class="form-input" placeholder="Ej: Paracetamol" />
              </div>
              <div class="form-group">
                <label class="form-label">Nombre comercial</label>
                <input type="text" class="form-input" placeholder="Ej: Tylenol" />
              </div>
              <div class="form-group">
                <label class="form-label">Concentración *</label>
                <input type="text" class="form-input" placeholder="Ej: 500 mg" />
              </div>
              <div class="form-group">
                <label class="form-label">Tipo de presentación *</label>
                <select class="form-select">
                  <option value="">Seleccionar...</option>
                  <option value="tabletas">Tabletas</option>
                  <option value="capsulas">Cápsulas</option>
                  <option value="frascos">Frascos</option>
                  <option value="sobres">Sobres</option>
                  <option value="ampolletas">Ampolletas</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Cantidad *</label>
                <input type="number" class="form-input" placeholder="Ej: 200" min="1" />
              </div>
              <div class="form-group">
                <label class="form-label">Fecha de vencimiento *</label>
                <input type="date" class="form-input" />
              </div>
            </div>

            <div class="form-actions">
              <button class="btn btn-ghost" onclick="prevStep(1)">
                ← Volver
              </button>
              <button class="btn btn-primary" onclick="nextStep(3)">
                Siguiente: Comprobante →
              </button>
            </div>
          </div>
        </div>

        <!-- PASO 3: COMPROBANTE -->
        <div class="form-step" id="step3">
          <div class="form-card">
            <div class="form-card-header">
              <span class="form-card-icon">📎</span>
              <div>
                <h2>Comprobante de Donación</h2>
                <p>Adjunta foto o remisión del lote ingresado (opcional)</p>
              </div>
            </div>

            <div class="upload-area">
              <div class="upload-icon">📄</div>
              <h3>Arrastra un archivo aquí</h3>
              <p>o haz clic para seleccionar</p>
              <span class="upload-formats">Formatos: JPG, PNG, PDF (Max. 5MB)</span>
              <input type="file" class="upload-input" accept=".jpg,.jpeg,.png,.pdf" />
            </div>

            <div class="form-note">
              <span>📋</span>
              <span>Este paso es opcional. Puedes subir una foto de la remisión o comprobante de la donación para futuras referencias.</span>
            </div>

            <div class="form-actions">
              <button class="btn btn-ghost" onclick="prevStep(2)">
                ← Volver
              </button>
              <button class="btn btn-primary btn-lg" onclick="submitForm()">
                ✅ Registrar Donación
              </button>
            </div>
          </div>
        </div>

        <!-- ÉXITO -->
        <div class="form-step" id="stepSuccess" style="display: none;">
          <div class="success-card">
            <div class="success-icon">✅</div>
            <h2>¡Donación Registrada!</h2>
            <p>El lote de medicamentos ha sido registrado exitosamente en el inventario.</p>
            <div class="success-actions">
              <a href="/inventario" class="btn btn-primary">Ver Inventario</a>
              <button class="btn btn-secondary" onclick="resetForm()">Registrar Otra Donación</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function nextStep(step: number) {
    document.querySelectorAll('.form-step').forEach(s => (s as HTMLElement).style.display = 'none');
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
    
    const target = document.getElementById(`step${step}`);
    if (target) {
      target.style.display = 'block';
      target.style.animation = 'fadeInUp 0.5s ease-out';
    }
    
    document.querySelectorAll('.step').forEach((s, i) => {
      if (i < step) s.classList.add('active');
    });
  }

  function prevStep(step: number) {
    nextStep(step);
  }

  function submitForm() {
    document.querySelectorAll('.form-step').forEach(s => (s as HTMLElement).style.display = 'none');
    document.querySelectorAll('.step').forEach(s => s.classList.add('active'));
    
    const success = document.getElementById('stepSuccess');
    if (success) {
      success.style.display = 'block';
      success.style.animation = 'scaleIn 0.5s ease-out';
    }
  }

  function resetForm() {
    nextStep(1);
  }

  // Hacer funciones globales
  (window as any).nextStep = nextStep;
  (window as any).prevStep = prevStep;
  (window as any).submitForm = submitForm;
  (window as any).resetForm = resetForm;
</script>

<style>
  .main-content {
    padding-top: 72px;
    min-height: 100vh;
    padding-bottom: 40px;
  }

  .page-header {
    padding: 40px 0 24px;
  }

  .page-header h1 {
    font-size: 1.8rem;
    color: var(--green-dark);
    margin-bottom: 4px;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  /* PASOS */
  .steps-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 32px;
    padding: 20px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
  }

  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }

  .step.active {
    background: var(--green-lighter);
  }

  .step-number {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--border);
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .step.active .step-number {
    background: var(--green-primary);
    color: white;
  }

  .step-label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .step.active .step-label {
    color: var(--green-primary);
    font-weight: 600;
  }

  .step-line {
    width: 60px;
    height: 2px;
    background: var(--border);
    margin: 0 8px;
  }

  /* FORMULARIO */
  .form-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .form-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-md);
    padding: 32px;
  }

  .form-card-header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-light);
  }

  .form-card-icon {
    font-size: 2rem;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--green-lighter);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .form-card-header h2 {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 4px;
  }

  .form-card-header p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 20px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 16px;
    background: var(--blue-light);
    border-radius: var(--radius-md);
    margin-top: 8px;
    margin-bottom: 24px;
  }

  .form-note span:first-child {
    flex-shrink: 0;
  }

  .form-note span:last-child {
    font-size: 0.85rem;
    color: var(--blue);
    line-height: 1.5;
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--border-light);
    margin-top: 8px;
  }

  /* UPLOAD */
  .upload-area {
    position: relative;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: 48px 24px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 20px;
  }

  .upload-area:hover {
    border-color: var(--green-primary);
    background: var(--green-lighter);
  }

  .upload-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .upload-area h3 {
    font-size: 1rem;
    color: var(--text);
    margin-bottom: 4px;
  }

  .upload-area p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .upload-formats {
    display: block;
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--text-light);
  }

  .upload-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* ÉXITO */
  .success-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--green-light);
    box-shadow: var(--shadow-lg);
    padding: 48px 32px;
    text-align: center;
  }

  .success-icon {
    font-size: 4rem;
    margin-bottom: 16px;
    animation: pulse 1s ease-in-out;
  }

  .success-card h2 {
    font-size: 1.5rem;
    color: var(--green-primary);
    margin-bottom: 8px;
  }

  .success-card p {
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  .success-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .steps-bar {
      flex-direction: column;
      gap: 8px;
    }

    .step-line {
      width: 2px;
      height: 20px;
      margin: 0;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-card {
      padding: 24px 20px;
    }

    .success-actions {
      flex-direction: column;
    }
  }
</style>
