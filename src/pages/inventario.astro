---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ExportButton from '../components/ExportButton.astro';
import prisma from '../lib/prisma';
import { calcularEstado, getEstadoBadge, formatDate } from '../lib/utils';

const search = Astro.url.searchParams.get('search') || '';
const tipo = Astro.url.searchParams.get('tipo') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 20;
const skip = (page - 1) * pageSize;

const searchFilter = {
  ...(search ? {
    OR: [
      { nombre_generico: { contains: search, mode: 'insensitive' as const } },
      { nombre_comercial: { contains: search, mode: 'insensitive' as const } },
    ],
  } : {}),
  ...(tipo ? { tipo_cantidad: tipo } : {}),
};

const [medicamentos, totalCount, totalUnidades, lotesActivos, porVencerCount, vencidosCount] = await Promise.all([
  prisma.medicamentos_inventario.findMany({
    where: searchFilter,
    include: { donante: { select: { nombre: true } } },
    orderBy: { creado_en: 'desc' },
    skip,
    take: pageSize,
  }),
  prisma.medicamentos_inventario.count({ where: searchFilter }),
  prisma.medicamentos_inventario.aggregate({ _sum: { cantidad_disponible: true } }),
  prisma.medicamentos_inventario.count(),
  prisma.medicamentos_inventario.count({
    where: { fecha_vencimiento: { lte: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000), gte: new Date() } },
  }),
  prisma.medicamentos_inventario.count({
    where: { fecha_vencimiento: { lt: new Date() } },
  }),
]);

const totalPages = Math.ceil(totalCount / pageSize);
---

<Layout title="Inventario | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <div class="header-top">
          <div>
            <h1><Icon name="clipboard-list" size={28} /> Inventario de Medicamentos</h1>
            <p>Consulta y administra el stock disponible en el centro de acopio</p>
          </div>
          <div class="header-actions">
            <ExportButton tipo="inventario" />
            <a href="/recibir" class="btn btn-primary">
              <span>+</span> Agregar Medicamento
            </a>
          </div>
        </div>
      </div>

      <form method="GET" class="filters-bar animate-fade-in-up delay-1">
        <div class="search-box">
          <span class="search-icon"><Icon name="search" size={18} /></span>
          <input type="text" name="search" value={search} placeholder="Buscar por nombre genérico o comercial..." class="form-input search-input" />
        </div>
        <div class="filter-group">
          <select name="tipo" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los tipos</option>
            <option value="Tabletas" selected={tipo === 'Tabletas'}>Tabletas</option>
            <option value="Cápsulas" selected={tipo === 'Cápsulas'}>Cápsulas</option>
            <option value="Frascos" selected={tipo === 'Frascos'}>Frascos</option>
            <option value="Sobres" selected={tipo === 'Sobres'}>Sobres</option>
          </select>
        </div>
      </form>

      <div class="summary-cards animate-fade-in-up delay-2">
        <div class="summary-card">
          <span class="summary-value">{(totalUnidades._sum.cantidad_disponible || 0).toLocaleString('es-CO')}</span>
          <span class="summary-label">Total Unidades</span>
        </div>
        <div class="summary-card">
          <span class="summary-value green">{lotesActivos}</span>
          <span class="summary-label">Lotes Activos</span>
        </div>
        <div class="summary-card warning">
          <span class="summary-value">{porVencerCount}</span>
          <span class="summary-label">Por Vencer</span>
        </div>
        <div class="summary-card danger">
          <span class="summary-value">{vencidosCount}</span>
          <span class="summary-label">Vencidos</span>
        </div>
      </div>

      <div class="table-container animate-fade-in-up delay-3">
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Medicamento</th>
                <th>Concentración</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Vencimiento</th>
                <th>Donante</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {medicamentos.map((med, i) => {
                const estado = calcularEstado(med.fecha_vencimiento);
                const badge = getEstadoBadge(estado);
                return (
                  <tr style={`animation: fadeInUp 0.4s ease-out ${i * 0.05}s both`}>
                    <td>
                      <div class="med-info">
                        <span class="med-generico">{med.nombre_generico}</span>
                        <span class="med-comercial">{med.nombre_comercial}</span>
                      </div>
                    </td>
                    <td>{med.concentracion}</td>
                    <td>{med.tipo_cantidad}</td>
                    <td>
                      <span class="cantidad-badge">{med.cantidad_disponible}</span>
                    </td>
                    <td>
                      <span class={estado === 'vencido' ? 'text-danger' : estado === 'por-vencer' ? 'text-warning' : ''}>
                        {formatDate(med.fecha_vencimiento)}
                      </span>
                    </td>
                    <td class="text-muted">{med.donante?.nombre || 'Sin donante'}</td>
                    <td>
                      <span class={`badge ${badge.class}`}>{badge.label}</span>
                    </td>
                    <td>
                      <div class="actions-cell">
                        <button
                          class="btn btn-ghost btn-sm edit-btn"
                          title="Editar"
                          data-id={med.id}
                          data-nombre={med.nombre_generico}
                          data-comercial={med.nombre_comercial || ''}
                          data-concentracion={med.concentracion || ''}
                          data-tipo={med.tipo_cantidad || ''}
                          data-cantidad={med.cantidad_disponible}
                          data-vencimiento={new Date(med.fecha_vencimiento).toISOString().split('T')[0]}
                        >
                          <Icon name="pencil" size={16} />
                        </button>
                        <button class="btn btn-ghost btn-sm delete-btn" title="Eliminar" data-id={med.id} data-nombre={med.nombre_generico}>
                          <Icon name="trash" size={16} />
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
              {medicamentos.length === 0 && (
                <tr>
                  <td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                    No se encontraron medicamentos
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <div class="pagination animate-fade-in-up delay-4">
        <span class="pagination-info">Página {page} de {totalPages} ({totalCount} total)</span>
        <div class="pagination-btns">
          {page > 1 && <a href={`?page=${page - 1}${search ? `&search=${search}` : ''}${tipo ? `&tipo=${tipo}` : ''}`} class="btn btn-ghost btn-sm">← Anterior</a>}
          {page < totalPages && <a href={`?page=${page + 1}${search ? `&search=${search}` : ''}${tipo ? `&tipo=${tipo}` : ''}`} class="btn btn-ghost btn-sm">Siguiente →</a>}
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <div class="modal-overlay" id="editModal" style="display: none;">
    <div class="modal">
      <div class="modal-header">
        <h2>Editar Medicamento</h2>
        <button class="modal-close" id="closeModal">&times;</button>
      </div>
      <form id="editForm" class="modal-body">
        <input type="hidden" name="id" id="editId" />
        <div class="modal-grid">
          <div class="form-group">
            <label class="form-label">Nombre generico *</label>
            <input type="text" name="nombre_generico" id="editNombre" class="form-input" required />
          </div>
          <div class="form-group">
            <label class="form-label">Nombre comercial</label>
            <input type="text" name="nombre_comercial" id="editComercial" class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label">Concentracion</label>
            <input type="text" name="concentracion" id="editConcentracion" class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label">Tipo</label>
            <select name="tipo_cantidad" id="editTipo" class="form-select">
              <option value="">Seleccionar...</option>
              <option value="Tabletas">Tabletas</option>
              <option value="Cápsulas">Cápsulas</option>
              <option value="Frascos">Frascos</option>
              <option value="Sobres">Sobres</option>
              <option value="Ampolletas">Ampolletas</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Cantidad *</label>
            <input type="number" name="cantidad_disponible" id="editCantidad" class="form-input" min="0" required />
          </div>
          <div class="form-group">
            <label class="form-label">Fecha vencimiento *</label>
            <input type="date" name="fecha_vencimiento" id="editVencimiento" class="form-input" required />
          </div>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="cancelEdit">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.delete-btn') as HTMLElement | null;
    if (btn) {
      const id = btn.dataset.id;
      const nombre = btn.dataset.nombre;
      if (!id) return;
      if (!confirm(`¿Eliminar "${nombre}" del inventario?`)) return;

      try {
        const res = await fetch(`/api/medicamentos/${id}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al eliminar');
        }
      } catch {
        alert('Error de conexion');
      }
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.edit-btn') as HTMLElement | null;
    if (btn) {
      const modal = document.getElementById('editModal')!;
      (document.getElementById('editId') as HTMLInputElement).value = btn.dataset.id || '';
      (document.getElementById('editNombre') as HTMLInputElement).value = btn.dataset.nombre || '';
      (document.getElementById('editComercial') as HTMLInputElement).value = btn.dataset.comercial || '';
      (document.getElementById('editConcentracion') as HTMLInputElement).value = btn.dataset.concentracion || '';
      (document.getElementById('editTipo') as HTMLSelectElement).value = btn.dataset.tipo || '';
      (document.getElementById('editCantidad') as HTMLInputElement).value = btn.dataset.cantidad || '';
      (document.getElementById('editVencimiento') as HTMLInputElement).value = btn.dataset.vencimiento || '';
      modal.style.display = 'flex';
    }
  });

  document.getElementById('closeModal')?.addEventListener('click', () => {
    document.getElementById('editModal')!.style.display = 'none';
  });

  document.getElementById('cancelEdit')?.addEventListener('click', () => {
    document.getElementById('editModal')!.style.display = 'none';
  });

  document.getElementById('editModal')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'editModal') {
      (e.target as HTMLElement).style.display = 'none';
    }
  });

  document.getElementById('editForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const id = (form.querySelector('#editId') as HTMLInputElement).value;
    const formData = new FormData(form);

    try {
      const res = await fetch(`/api/medicamentos/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre_generico: formData.get('nombre_generico'),
          nombre_comercial: formData.get('nombre_comercial'),
          concentracion: formData.get('concentracion'),
          tipo_cantidad: formData.get('tipo_cantidad'),
          cantidad_disponible: formData.get('cantidad_disponible'),
          fecha_vencimiento: formData.get('fecha_vencimiento'),
        }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('Error al actualizar');
      }
    } catch {
      alert('Error de conexion');
    }
  });
</script>

<style>
  .main-content { padding-top: 72px; min-height: 100vh; }
  .page-header { padding: 40px 0 24px; }
  .header-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .header-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .page-header h1 { font-size: 1.8rem; color: var(--green-dark); margin-bottom: 4px; }
  .page-header p { color: var(--text-muted); font-size: 1rem; }
  .filters-bar { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .search-box { flex: 1; min-width: 280px; position: relative; }
  .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); z-index: 1; display: flex; align-items: center; color: var(--text-muted); }
  .search-input { padding-left: 42px !important; width: 100%; }
  .filter-group { display: flex; gap: 12px; }
  .filter-group .form-select { min-width: 160px; }
  .summary-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .summary-card { padding: 20px; background: var(--surface); border-radius: var(--radius-md); border: 1px solid var(--border-light); text-align: center; }
  .summary-card.warning { border-color: var(--warning); background: var(--warning-light); }
  .summary-card.danger { border-color: var(--danger); background: var(--danger-light); }
  .summary-value { display: block; font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; color: var(--green-dark); line-height: 1; }
  .summary-card.warning .summary-value { color: var(--warning); }
  .summary-card.danger .summary-value { color: var(--danger); }
  .summary-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
  .table-scroll { overflow-x: auto; }
  .med-info { display: flex; flex-direction: column; }
  .med-generico { font-weight: 600; color: var(--text); }
  .med-comercial { font-size: 0.8rem; color: var(--text-light); }
  .cantidad-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; padding: 4px 12px; background: var(--green-lighter); color: var(--green-primary); border-radius: 100px; font-weight: 700; font-size: 0.9rem; }
  .text-danger { color: var(--danger) !important; font-weight: 600; }
  .text-warning { color: var(--warning) !important; font-weight: 600; }
  .text-muted { color: var(--text-muted); }
  .actions-cell { display: flex; gap: 4px; }
  .delete-btn:hover { color: var(--danger) !important; background: var(--danger-light) !important; }
  .edit-btn:hover { color: var(--blue) !important; background: var(--blue-light) !important; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
  .modal { background: var(--surface); border-radius: var(--radius-lg); width: 100%; max-width: 560px; box-shadow: var(--shadow-lg); }
  .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border-light); }
  .modal-header h2 { font-size: 1.2rem; color: var(--text); margin: 0; }
  .modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted); padding: 4px 8px; border-radius: var(--radius-sm); }
  .modal-close:hover { background: var(--bg); }
  .modal-body { padding: 24px; }
  .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .modal-grid .form-group { display: flex; flex-direction: column; gap: 6px; }
  .modal-grid .form-label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .modal-grid .form-input, .modal-grid .form-select { padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 0.9rem; background: var(--bg); color: var(--text); }
  .modal-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-light); }
  .pagination { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; }
  .pagination-info { font-size: 0.85rem; color: var(--text-muted); }
  .pagination-btns { display: flex; gap: 8px; }
  @media (max-width: 768px) { .header-top { flex-direction: column; } .filters-bar { flex-direction: column; } .filter-group { flex-direction: column; } .summary-cards { grid-template-columns: repeat(2, 1fr); } }
</style>
