---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ExportButton from '../components/ExportButton.astro';
import prisma from '../lib/prisma';
import { calcularEstado, getEstadoBadge, formatDate } from '../lib/utils';

const search = Astro.url.searchParams.get('search') || '';
const tipo = Astro.url.searchParams.get('tipo') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 20;
const skip = (page - 1) * pageSize;

const searchFilter = {
  ...(search ? {
    OR: [
      { nombre_generico: { contains: search, mode: 'insensitive' as const } },
      { nombre_comercial: { contains: search, mode: 'insensitive' as const } },
    ],
  } : {}),
  ...(tipo ? { tipo_cantidad: tipo } : {}),
};

const [medicamentos, totalCount, totalUnidades, lotesActivos, porVencerCount, vencidosCount] = await Promise.all([
  prisma.medicamentos_inventario.findMany({
    where: searchFilter,
    include: { donante: { select: { nombre: true } } },
    orderBy: { creado_en: 'desc' },
    skip,
    take: pageSize,
  }),
  prisma.medicamentos_inventario.count({ where: searchFilter }),
  prisma.medicamentos_inventario.aggregate({ _sum: { cantidad_disponible: true } }),
  prisma.medicamentos_inventario.count(),
  prisma.medicamentos_inventario.count({
    where: { fecha_vencimiento: { lte: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000), gte: new Date() } },
  }),
  prisma.medicamentos_inventario.count({
    where: { fecha_vencimiento: { lt: new Date() } },
  }),
]);

const totalPages = Math.ceil(totalCount / pageSize);
---

<Layout title="Inventario | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <div class="header-top">
          <div>
            <h1><Icon name="clipboard-list" size={28} /> Inventario de Medicamentos</h1>
            <p>Consulta y administra el stock disponible en el centro de acopio</p>
          </div>
          <div class="header-actions">
            <ExportButton tipo="inventario" />
            <a href="/recibir" class="btn btn-primary">
              <span>+</span> Agregar Medicamento
            </a>
          </div>
        </div>
      </div>

      <form method="GET" class="filters-bar animate-fade-in-up delay-1">
        <div class="search-box">
          <span class="search-icon"><Icon name="search" size={18} /></span>
          <input type="text" name="search" value={search} placeholder="Buscar por nombre genérico o comercial..." class="form-input search-input" />
        </div>
        <div class="filter-group">
          <select name="tipo" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los tipos</option>
            <option value="Tabletas" selected={tipo === 'Tabletas'}>Tabletas</option>
            <option value="Cápsulas" selected={tipo === 'Cápsulas'}>Cápsulas</option>
            <option value="Frascos" selected={tipo === 'Frascos'}>Frascos</option>
            <option value="Sobres" selected={tipo === 'Sobres'}>Sobres</option>
          </select>
        </div>
      </form>

      <div class="summary-cards animate-fade-in-up delay-2">
        <div class="summary-card">
          <span class="summary-value">{(totalUnidades._sum.cantidad_disponible || 0).toLocaleString('es-CO')}</span>
          <span class="summary-label">Total Unidades</span>
        </div>
        <div class="summary-card">
          <span class="summary-value green">{lotesActivos}</span>
          <span class="summary-label">Lotes Activos</span>
        </div>
        <div class="summary-card warning">
          <span class="summary-value">{porVencerCount}</span>
          <span class="summary-label">Por Vencer</span>
        </div>
        <div class="summary-card danger">
          <span class="summary-value">{vencidosCount}</span>
          <span class="summary-label">Vencidos</span>
        </div>
      </div>

      <div class="table-container animate-fade-in-up delay-3">
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Medicamento</th>
                <th>Concentración</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Vencimiento</th>
                <th>Donante</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {medicamentos.map((med, i) => {
                const estado = calcularEstado(med.fecha_vencimiento);
                const badge = getEstadoBadge(estado);
                return (
                  <tr style={`animation: fadeInUp 0.4s ease-out ${i * 0.05}s both`}>
                    <td>
                      <div class="med-info">
                        <span class="med-generico">{med.nombre_generico}</span>
                        <span class="med-comercial">{med.nombre_comercial}</span>
                      </div>
                    </td>
                    <td>{med.concentracion}</td>
                    <td>{med.tipo_cantidad}</td>
                    <td>
                      <span class="cantidad-badge">{med.cantidad_disponible}</span>
                    </td>
                    <td>
                      <span class={estado === 'vencido' ? 'text-danger' : estado === 'por-vencer' ? 'text-warning' : ''}>
                        {formatDate(med.fecha_vencimiento)}
                      </span>
                    </td>
                    <td class="text-muted">{med.donante?.nombre || 'Sin donante'}</td>
                    <td>
                      <span class={`badge ${badge.class}`}>{badge.label}</span>
                    </td>
                    <td>
                      <div class="actions-cell">
                        <button class="btn btn-ghost btn-sm" title="Editar"><Icon name="pencil" size={16} /></button>
                        <button class="btn btn-ghost btn-sm" title="Eliminar"><Icon name="trash" size={16} /></button>
                      </div>
                    </td>
                  </tr>
                );
              })}
              {medicamentos.length === 0 && (
                <tr>
                  <td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                    No se encontraron medicamentos
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <div class="pagination animate-fade-in-up delay-4">
        <span class="pagination-info">Página {page} de {totalPages} ({totalCount} total)</span>
        <div class="pagination-btns">
          {page > 1 && <a href={`?page=${page - 1}${search ? `&search=${search}` : ''}${tipo ? `&tipo=${tipo}` : ''}`} class="btn btn-ghost btn-sm">← Anterior</a>}
          {page < totalPages && <a href={`?page=${page + 1}${search ? `&search=${search}` : ''}${tipo ? `&tipo=${tipo}` : ''}`} class="btn btn-ghost btn-sm">Siguiente →</a>}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding-top: 72px; min-height: 100vh; }
  .page-header { padding: 40px 0 24px; }
  .header-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .header-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .page-header h1 { font-size: 1.8rem; color: var(--green-dark); margin-bottom: 4px; }
  .page-header p { color: var(--text-muted); font-size: 1rem; }
  .filters-bar { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .search-box { flex: 1; min-width: 280px; position: relative; }
  .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); z-index: 1; display: flex; align-items: center; color: var(--text-muted); }
  .search-input { padding-left: 42px !important; width: 100%; }
  .filter-group { display: flex; gap: 12px; }
  .filter-group .form-select { min-width: 160px; }
  .summary-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .summary-card { padding: 20px; background: var(--surface); border-radius: var(--radius-md); border: 1px solid var(--border-light); text-align: center; }
  .summary-card.warning { border-color: var(--warning); background: var(--warning-light); }
  .summary-card.danger { border-color: var(--danger); background: var(--danger-light); }
  .summary-value { display: block; font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; color: var(--green-dark); line-height: 1; }
  .summary-card.warning .summary-value { color: var(--warning); }
  .summary-card.danger .summary-value { color: var(--danger); }
  .summary-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
  .table-scroll { overflow-x: auto; }
  .med-info { display: flex; flex-direction: column; }
  .med-generico { font-weight: 600; color: var(--text); }
  .med-comercial { font-size: 0.8rem; color: var(--text-light); }
  .cantidad-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; padding: 4px 12px; background: var(--green-lighter); color: var(--green-primary); border-radius: 100px; font-weight: 700; font-size: 0.9rem; }
  .text-danger { color: var(--danger) !important; font-weight: 600; }
  .text-warning { color: var(--warning) !important; font-weight: 600; }
  .text-muted { color: var(--text-muted); }
  .actions-cell { display: flex; gap: 4px; }
  .pagination { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; }
  .pagination-info { font-size: 0.85rem; color: var(--text-muted); }
  .pagination-btns { display: flex; gap: 8px; }
  @media (max-width: 768px) { .header-top { flex-direction: column; } .filters-bar { flex-direction: column; } .filter-group { flex-direction: column; } .summary-cards { grid-template-columns: repeat(2, 1fr); } }
</style>
