---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import prisma from '../lib/prisma';

const medicamentosDisponibles = await prisma.medicamentos_inventario.findMany({
  where: { cantidad_disponible: { gt: 0 } },
  orderBy: { nombre_generico: 'asc' },
});
---

<Layout title="Entregar Medicamento | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <h1>📤 Entregar Medicamento</h1>
        <p>Procesa la entrega de medicamentos a un beneficiario con fórmula médica</p>
      </div>

      <form id="entregaForm" class="entrega-layout">
        <div class="form-section animate-slide-left">
          <div class="form-card">
            <div class="form-card-header">
              <span class="form-card-icon">👤</span>
              <div>
                <h2>Datos del Beneficiario</h2>
                <p>Información de la persona que recibe los medicamentos</p>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Nombre completo *</label>
              <input type="text" name="beneficiario_nombre" class="form-input" placeholder="Ej: María López García" required />
            </div>

            <div class="form-group">
              <label class="form-label">Dirección *</label>
              <input type="text" name="beneficiario_direccion" class="form-input" placeholder="Ej: Calle 45 #12-34, Barrio San José" required />
            </div>

            <div class="form-group">
              <label class="form-label">Número de celular</label>
              <input type="tel" name="beneficiario_celular" class="form-input" placeholder="Ej: 300 123 4567" />
            </div>
          </div>
        </div>

        <div class="meds-section animate-slide-right delay-2">
          <div class="form-card">
            <div class="form-card-header">
              <span class="form-card-icon">💊</span>
              <div>
                <h2>Medicamentos a Entregar</h2>
                <p>Selecciona y define la cantidad de cada medicamento</p>
              </div>
            </div>

            <div class="meds-list">
              {medicamentosDisponibles.map((med) => (
                <div class="med-item">
                  <div class="med-info">
                    <span class="med-nombre">{med.nombre_generico} {med.nombre_comercial ? `(${med.nombre_comercial})` : ''}</span>
                    <span class="med-detail">{med.concentracion} · {med.tipo_cantidad} · {med.cantidad_disponible} disponibles</span>
                  </div>
                  <div class="med-qty">
                    <label class="form-label" style="margin-bottom: 4px;">Cantidad a entregar</label>
                    <div class="qty-input-group">
                      <button type="button" class="qty-btn" onclick={`adjustQty(${med.id}, -1, ${med.cantidad_disponible})`}>−</button>
                      <input type="number" class="qty-input" name={`med_${med.id}`} id={`qty-${med.id}`} min="0" max={med.cantidad_disponible} value="0" data-max={med.cantidad_disponible} />
                      <button type="button" class="qty-btn" onclick={`adjustQty(${med.id}, 1, ${med.cantidad_disponible})`}>+</button>
                    </div>
                  </div>
                </div>
              ))}
              {medicamentosDisponibles.length === 0 && (
                <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                  No hay medicamentos disponibles en inventario
                </div>
              )}
            </div>

            <div class="meds-summary">
              <div class="summary-row">
                <span>Total medicamentos seleccionados:</span>
                <span class="summary-total" id="totalMeds">0</span>
              </div>
            </div>

            <div class="form-actions">
              <div></div>
              <button type="submit" class="btn btn-primary btn-lg">✅ Confirmar Entrega</button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function adjustQty(id: number, delta: number, max: number) {
    const input = document.getElementById(`qty-${id}`) as HTMLInputElement;
    if (!input) return;
    let val = parseInt(input.value || '0') + delta;
    val = Math.max(0, Math.min(val, max));
    input.value = val.toString();
    updateTotal();
  }

  function updateTotal() {
    let total = 0;
    document.querySelectorAll('.qty-input').forEach((el) => {
      total += parseInt((el as HTMLInputElement).value || '0');
    });
    const el = document.getElementById('totalMeds');
    if (el) el.textContent = total.toString();
  }

  (window as any).adjustQty = adjustQty;

  document.getElementById('entregaForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const medicamentos: { id: number; cantidad: number }[] = [];
    form.querySelectorAll('.qty-input').forEach((input) => {
      const qty = parseInt((input as HTMLInputElement).value || '0');
      if (qty > 0) {
        const id = parseInt((input as HTMLInputElement).id.replace('qty-', ''));
        medicamentos.push({ id, cantidad: qty });
      }
    });

    if (medicamentos.length === 0) {
      alert('Selecciona al menos un medicamento');
      return;
    }

    const payload = {
      beneficiario: {
        nombre: formData.get('beneficiario_nombre'),
        direccion: formData.get('beneficiario_direccion'),
        celular: formData.get('beneficiario_celular'),
      },
      medicamentos,
    };

    try {
      const res = await fetch('/api/entregas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        alert('¡Entrega procesada exitosamente!');
        window.location.href = '/inventario';
      } else {
        alert('Error al procesar la entrega');
      }
    } catch (err) {
      alert('Error de conexión');
    }
  });
</script>

<style>
  .main-content { padding-top: 72px; min-height: 100vh; padding-bottom: 40px; }
  .page-header { padding: 40px 0 24px; }
  .page-header h1 { font-size: 1.8rem; color: var(--green-dark); margin-bottom: 4px; }
  .page-header p { color: var(--text-muted); font-size: 1rem; }
  .entrega-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px; align-items: start; }
  .form-card { background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-md); padding: 28px; }
  .form-card-header { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border-light); }
  .form-card-icon { font-size: 1.6rem; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: var(--green-lighter); border-radius: var(--radius-md); flex-shrink: 0; }
  .form-card-header h2 { font-size: 1.05rem; color: var(--text); margin-bottom: 2px; }
  .form-card-header p { color: var(--text-muted); font-size: 0.85rem; }
  .meds-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .med-item { display: flex; justify-content: space-between; align-items: center; padding: 16px; background: var(--surface-hover); border-radius: var(--radius-md); border: 1px solid var(--border-light); gap: 16px; }
  .med-info { display: flex; flex-direction: column; }
  .med-nombre { font-weight: 600; color: var(--text); font-size: 0.95rem; }
  .med-detail { font-size: 0.8rem; color: var(--text-light); margin-top: 2px; }
  .med-qty { display: flex; flex-direction: column; align-items: flex-end; }
  .qty-input-group { display: flex; align-items: center; gap: 0; border: 2px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .qty-btn { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: var(--green-lighter); color: var(--green-primary); font-size: 1.1rem; font-weight: 700; transition: all 0.2s; }
  .qty-btn:hover { background: var(--green-primary); color: white; }
  .qty-input { width: 56px; height: 36px; text-align: center; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); font-weight: 700; font-size: 1rem; font-family: var(--font-display); -moz-appearance: textfield; }
  .qty-input::-webkit-inner-spin-button, .qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .qty-input:focus { outline: none; background: var(--green-lighter); }
  .meds-summary { padding: 16px; background: var(--green-lighter); border-radius: var(--radius-md); margin-bottom: 20px; }
  .summary-row { display: flex; justify-content: space-between; align-items: center; font-weight: 500; }
  .summary-total { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--green-primary); }
  .form-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border-light); }
  @media (max-width: 768px) { .entrega-layout { grid-template-columns: 1fr; } }
</style>
