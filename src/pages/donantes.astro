---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import ExportButton from '../components/ExportButton.astro';
import prisma from '../lib/prisma';
import { Prisma } from '@prisma/client';
import { formatDate, formatNumber } from '../lib/utils';

const search = Astro.url.searchParams.get('search') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 15;
const skip = (page - 1) * pageSize;

const whereClause = search ? {
  OR: [
    { nombre: { contains: search, mode: 'insensitive' } },
    { correo: { contains: search, mode: 'insensitive' } },
  ],
} : undefined;

const whereSql = search
  ? Prisma.sql`WHERE d.nombre ILIKE ${'%' + search + '%'} OR d.correo ILIKE ${'%' + search + '%'}`
  : Prisma.empty;

const donantesStats = await prisma.$queryRaw<{
  id: number; nombre: string; celular: string | null; correo: string | null;
  donaciones: bigint; total_tabletas: bigint; fecha_ultima: Date | null;
}[]>`
  SELECT
    d.id, d.nombre, d.celular, d.correo,
    COUNT(mi.id) AS donaciones,
    COALESCE(SUM(mi.cantidad_disponible), 0) AS total_tabletas,
    MAX(mi.creado_en) AS fecha_ultima
  FROM donantes d
  LEFT JOIN medicamentos_inventario mi ON mi.donante_id = d.id
  ${whereSql}
  GROUP BY d.id, d.nombre, d.celular, d.correo
  ORDER BY d.nombre ASC
  LIMIT ${pageSize} OFFSET ${skip}
`;

const countResult = await prisma.$queryRaw<{ count: bigint }[]>`
  SELECT COUNT(*) AS count FROM donantes d
  ${whereSql}
`;
const totalCount = Number(countResult[0]?.count || 0);

const donantes = donantesStats.map(d => ({
  id: d.id,
  nombre: d.nombre,
  celular: d.celular,
  correo: d.correo,
  donaciones: Number(d.donaciones),
  fechaUltima: d.fecha_ultima,
  totalTabletas: Number(d.total_tabletas),
}));

const totalPages = Math.ceil(totalCount / pageSize);

const [totalDonantesResult, totalTabletasResult] = await Promise.all([
  prisma.donantes.count(),
  prisma.medicamentos_inventario.aggregate({ _sum: { cantidad_disponible: true } }),
]);

const totalTabletas = totalTabletasResult._sum.cantidad_disponible || 0;
---

<Layout title="Donantes | Centro de Acopio Guadalupe">
  <Navbar />

  <main class="main-content">
    <div class="container">
      <div class="page-header animate-fade-in-up">
        <div class="header-top">
          <div>
            <h1><Icon name="handshake" size={28} /> Donantes</h1>
            <p>Personas y organizaciones que contribuyen con medicamentos al centro de acopio</p>
          </div>
          <ExportButton tipo="donantes" />
        </div>
      </div>

      <form method="GET" class="search-section animate-fade-in-up delay-1">
        <div class="search-box">
          <span class="search-icon"><Icon name="search" size={18} /></span>
          <input type="text" name="search" value={search} placeholder="Buscar por nombre o correo..." class="form-input search-input" />
        </div>
      </form>

      <div class="summary-banner animate-fade-in-up delay-2">
        <div class="summary-item">
          <span class="summary-icon"><Icon name="users" size={24} /></span>
          <div>
            <span class="summary-value">{totalDonantesResult}</span>
            <span class="summary-label">Donantes Registrados</span>
          </div>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-item">
          <span class="summary-icon"><Icon name="package" size={24} /></span>
          <div>
            <span class="summary-value">{formatNumber(totalTabletas)}</span>
            <span class="summary-label">Tabletas Recibidas</span>
          </div>
        </div>
      </div>

      <div class="table-container animate-fade-in-up delay-3">
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Donante</th>
                <th>Contacto</th>
                <th>Donaciones</th>
                <th>Total Tabletas</th>
                <th>Última Donación</th>
              </tr>
            </thead>
            <tbody>
              {donantes.map((d, i) => (
                <tr style={`animation: fadeInUp 0.4s ease-out ${i * 0.05}s both`}>
                  <td>
                    <div class="donor-cell">
                      <div class="donor-avatar">{d.nombre.charAt(0)}</div>
                      <div class="donor-info">
                        <span class="donor-name">{d.nombre}</span>
                        <span class="donor-id">ID: #{d.id.toString().padStart(4, '0')}</span>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="contact-cell">
                      {d.celular && <span><Icon name="smartphone" size={14} /> {d.celular}</span>}
                      {d.correo && <span class="correo"><Icon name="mail" size={14} /> {d.correo}</span>}
                    </div>
                  </td>
                  <td>
                    <span class="donation-count">{d.donaciones}</span>
                  </td>
                  <td>
                    <span class="tabletas-badge">{formatNumber(d.totalTabletas)}</span>
                  </td>
                  <td>{d.fechaUltima ? formatDate(d.fechaUltima) : '-'}</td>
                </tr>
              ))}
              {donantes.length === 0 && (
                <tr>
                  <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                    No se encontraron donantes
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      {totalPages > 1 && (
        <div class="pagination">
          <span class="pagination-info">Página {page} de {totalPages} ({totalCount} total)</span>
          <div class="pagination-btns">
            {page > 1 && <a href={`?page=${page - 1}${search ? `&search=${search}` : ''}`} class="btn btn-ghost btn-sm">← Anterior</a>}
            {page < totalPages && <a href={`?page=${page + 1}${search ? `&search=${search}` : ''}`} class="btn btn-ghost btn-sm">Siguiente →</a>}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .main-content { padding-top: 72px; min-height: 100vh; padding-bottom: 40px; }
  .page-header { padding: 40px 0 24px; }
  .header-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .page-header h1 { font-size: 1.8rem; color: var(--green-dark); margin-bottom: 4px; }
  .page-header p { color: var(--text-muted); font-size: 1rem; }
  .search-section { margin-bottom: 24px; }
  .search-box { position: relative; max-width: 400px; }
  .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; color: var(--text-muted); }
  .search-input { padding-left: 42px !important; width: 100%; }
  .summary-banner { display: flex; align-items: center; gap: 32px; padding: 24px 32px; background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-primary) 100%); border-radius: var(--radius-lg); margin-bottom: 24px; color: white; }
  .summary-item { display: flex; align-items: center; gap: 12px; }
  .summary-icon { font-size: 1.8rem; opacity: 0.9; }
  .summary-value { display: block; font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .summary-label { display: block; font-size: 0.8rem; opacity: 0.8; margin-top: 2px; }
  .summary-divider { width: 1px; height: 40px; background: rgba(255, 255, 255, 0.2); }
  .table-scroll { overflow-x: auto; }
  .donor-cell { display: flex; align-items: center; gap: 12px; }
  .donor-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--green-primary), var(--blue)); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 1rem; flex-shrink: 0; }
  .donor-info { display: flex; flex-direction: column; }
  .donor-name { font-weight: 600; color: var(--text); }
  .donor-id { font-size: 0.75rem; color: var(--text-light); }
  .contact-cell { display: flex; flex-direction: column; gap: 2px; font-size: 0.85rem; color: var(--text-muted); }
  .correo { font-size: 0.8rem; color: var(--blue); display: flex; align-items: center; gap: 4px; }
  .donation-count { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; padding: 4px 12px; background: var(--blue-light); color: var(--blue); border-radius: 100px; font-weight: 700; font-size: 0.9rem; }
  .tabletas-badge { display: inline-flex; align-items: center; padding: 4px 12px; background: var(--green-lighter); color: var(--green-primary); border-radius: 100px; font-weight: 700; font-size: 0.85rem; }
  .pagination { display: flex; justify-content: space-between; align-items: center; padding: 24px 0; margin-top: 16px; }
  .pagination-info { font-size: 0.85rem; color: var(--text-muted); }
  .pagination-btns { display: flex; gap: 8px; }
  @media (max-width: 768px) { .header-top { flex-direction: column; } .summary-banner { flex-direction: column; gap: 16px; text-align: center; } .summary-divider { width: 60px; height: 1px; } }
</style>
